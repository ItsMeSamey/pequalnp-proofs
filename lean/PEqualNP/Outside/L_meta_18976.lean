def w (u v : V) := (table[u.val]!)[v.val]!

def Covered (S : Finset V) : Prop := ∃ h ∈ masks, ∃ a ∈ mults, ∃ b : V,
  ∀ k : V, decide (k ∈ S) = h.testBit (a*k+b).val

set_option maxRecDepth 5000 in
set_option maxHeartbeats 10000000 in
theorem entry : ∀ u v : V,
    (w u v).1 ∈ masks ∧ (w u v).2.1 ∈ mults ∧ ∀ k : V,
      decide (k=0 ∨ k=u ∨ k=v) =
        (w u v).1.testBit ((w u v).2.1*k+(w u v).2.2).val := by
  decide +kernel

theorem triple (x y z : V) : Covered {x,y,z} := by
  obtain ⟨hm,ha,he⟩ := entry (y-x) (z-x)
  let t := w (y-x) (z-x)
  refine ⟨t.1,hm,t.2.1,ha,t.2.2-t.2.1*x,?_⟩
  intro k
  have he' := he (k-x)
  change _ = t.1.testBit (t.2.1*(k-x)+t.2.2).val at he'
  rw [show t.2.1*k + (t.2.2-t.2.1*x) = t.2.1*(k-x)+t.2.2 by simp [sub_eq_add_neg, mul_add, add_comm, add_left_comm]]
  simpa [sub_eq_zero, sub_left_inj] using he'

